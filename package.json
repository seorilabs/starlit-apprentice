{
  "name": "starlit-apprentice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "legacy:build": "pnpm --filter @starlit-apprentice/product-core build",
    "legacy:test": "pnpm --filter @starlit-apprentice/product-core test",
    "legacy:balance": "node legacy/scripts/check-ending-reachability.mjs",
    "legacy:pacing": "node legacy/scripts/check-pacing.mjs",
    "legacy:content": "node legacy/scripts/check-content-integrity.mjs",
    "legacy:save-contract": "node legacy/scripts/check-save-contract.mjs",
    "legacy:target-guidance": "node legacy/scripts/check-target-guidance.mjs",
    "legacy:public-url": "node legacy/scripts/check-public-url-guard.mjs",
    "legacy:all": "pnpm legacy:build && pnpm legacy:test && pnpm legacy:balance && pnpm legacy:pacing && pnpm legacy:content && pnpm legacy:save-contract && pnpm legacy:target-guidance && pnpm legacy:public-url",
    "godot:gate": "bash scripts/godot_quality_gate.sh --project .",
    "godot:core": "$GODOT_BIN --headless --path . --script res://tests/core_test_runner.gd",
    "godot:smoke": "$GODOT_BIN --headless --path . --script res://tests/test_runner.gd",
    "godot:arch": "python3 tools/check_core_boundary.py .",
    "godot:web": "$GODOT_BIN --headless --path . --export-release Web build/web/index.html",
    "godot:budget": "bash scripts/check_web_budget.sh .",
    "godot:equivalence": "$GODOT_BIN --headless --path . --script res://tests/legacy_equivalence_runner.gd",
    "godot:test": "bash scripts/test_all.sh",
    "godot:docs": "bash scripts/check_docs.sh .",
    "art:finalize": "bash scripts/finalize_art.sh assets/art"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
