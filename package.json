{
  "name": "starlit-apprentice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @starlit-apprentice/app dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @starlit-apprentice/product-core test",
    "assets:generate:registration": "node scripts/generate-registration-images.mjs",
    "assets:generate:stores": "node scripts/generate-market-store-assets.mjs",
    "assets:sync:ios-icons": "node scripts/sync-ios-app-icons.mjs",
    "assets:sync:android-icons": "node scripts/sync-android-app-icons.mjs",
    "assets:sync:native-splash": "node scripts/sync-native-splash.mjs",
    "assets:generate": "pnpm assets:generate:registration && pnpm assets:generate:stores && pnpm assets:sync:ios-icons && pnpm assets:sync:android-icons && pnpm assets:sync:native-splash",
    "build:android:qa-apk": "node scripts/build-android-qa-apk.mjs",
    "build:android:aab": "node scripts/build-android-release-bundle.mjs",
    "build:ios:release": "node scripts/build-ios-release.mjs",
    "build:apps-in-toss:ait": "pnpm --filter @starlit-apprentice/app build:apps-in-toss",
    "build:apps-in-toss:candidate": "node scripts/build-apps-in-toss-candidate.mjs",
    "release:artifact-manifest": "node scripts/release-artifact-manifest.mjs",
    "release:manual-qa-packet": "pnpm --filter @starlit-apprentice/product-core build && node scripts/manual-qa-packet.mjs",
    "release:console-packet": "node scripts/release-console-packet.mjs",
    "release:rating-content-inventory": "pnpm --filter @starlit-apprentice/product-core build && node scripts/rating-content-inventory.mjs",
    "release:public-pages": "node scripts/public-release-pages.mjs",
    "release:store-submission-packet": "node scripts/store-submission-packet.mjs",
    "release:gate-dashboard": "node scripts/release-gate-dashboard.mjs",
    "release:approval-packet": "node scripts/release-approval-packet.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:assets": "node scripts/check-registration-images.mjs --spec specs/starlit-apprentice.json",
    "check:store-config": "pnpm --filter @starlit-apprentice/product-core build && node scripts/check-market-store-config.mjs --allow-manual-blockers",
    "check:store-config:strict": "pnpm --filter @starlit-apprentice/product-core build && node scripts/check-market-store-config.mjs",
    "check:versioning": "node scripts/check-versioning.mjs",
    "check:webview-security": "pnpm --filter @starlit-apprentice/app build && node scripts/check-webview-security.mjs",
    "check:native-bundle-sync": "pnpm --filter @starlit-apprentice/app build && node scripts/check-native-bundle-sync.mjs",
    "check:privacy": "node scripts/check-privacy-evidence.mjs",
    "check:analytics-contract": "node scripts/check-analytics-contract.mjs",
    "check:third-party-notices": "node scripts/check-third-party-notices.mjs",
    "check:android:icons": "node scripts/sync-android-app-icons.mjs --check",
    "check:native-splash": "node scripts/sync-native-splash.mjs --check",
    "check:android:qa-apk": "node scripts/check-android-qa-apk.mjs",
    "check:play": "pnpm check:android:icons && node scripts/check-google-play-release.mjs --allow-manual-blockers",
    "check:play:local-artifact": "pnpm check:android:icons && node scripts/check-google-play-release.mjs --allow-manual-blockers --require-local-artifact",
    "check:play:strict": "pnpm check:android:icons && node scripts/check-google-play-release.mjs",
    "check:app-store": "node scripts/check-app-store-release.mjs --allow-manual-blockers",
    "check:app-store:local-artifact": "node scripts/check-app-store-release.mjs --allow-manual-blockers --require-local-artifact",
    "check:app-store:strict": "node scripts/check-app-store-release.mjs",
    "check:apps-in-toss": "node scripts/check-apps-in-toss-release.mjs --allow-manual-blockers",
    "check:apps-in-toss:strict": "node scripts/check-apps-in-toss-release.mjs",
    "check:manual-qa": "pnpm --filter @starlit-apprentice/product-core build && node scripts/check-manual-qa-evidence.mjs --allow-manual-blockers",
    "check:manual-qa:strict": "pnpm --filter @starlit-apprentice/product-core build && node scripts/check-manual-qa-evidence.mjs",
    "check:release-console-packet": "node scripts/release-console-packet.mjs --check",
    "check:release-console": "node scripts/check-release-console-evidence.mjs --allow-manual-blockers",
    "check:release-console:strict": "node scripts/check-release-console-evidence.mjs",
    "check:rating-content-inventory": "pnpm --filter @starlit-apprentice/product-core build && node scripts/rating-content-inventory.mjs --check",
    "check:public-pages": "node scripts/public-release-pages.mjs --check",
    "check:store-submission-packet": "node scripts/store-submission-packet.mjs --check",
    "check:release-gate-dashboard": "node scripts/release-gate-dashboard.mjs --check",
    "check:release-approval-packet": "node scripts/release-approval-packet.mjs --check",
    "check:release-approval": "node scripts/check-release-approval-evidence.mjs --allow-manual-blockers",
    "check:release-approval:strict": "node scripts/check-release-approval-evidence.mjs",
    "check:content": "pnpm --filter @starlit-apprentice/product-core build && node scripts/check-content-integrity.mjs",
    "check:save-contract": "pnpm --filter @starlit-apprentice/product-core build && node scripts/check-save-contract.mjs",
    "check:target-guidance": "pnpm --filter @starlit-apprentice/product-core build && node scripts/check-target-guidance.mjs",
    "check:balance": "pnpm --filter @starlit-apprentice/product-core build && node scripts/check-ending-reachability.mjs",
    "check:pacing": "pnpm --filter @starlit-apprentice/product-core build && node scripts/check-pacing.mjs",
    "check:runtime": "pnpm --filter @starlit-apprentice/product-core build && pnpm --filter @starlit-apprentice/app build && node scripts/check-runtime-smoke.mjs",
    "check:ui-accessibility": "pnpm --filter @starlit-apprentice/app build && node scripts/check-ui-accessibility.mjs",
    "check:bundle-budget": "pnpm --filter @starlit-apprentice/app build && node scripts/check-bundle-budget.mjs",
    "check:package": "pnpm --filter @starlit-apprentice/product-core build && node scripts/check-product-core-dist.mjs",
    "check:public-url-guard": "pnpm --filter @starlit-apprentice/product-core build && node scripts/check-public-url-guard.mjs",
    "check:release-verification-commands": "node scripts/check-release-verification-commands.mjs",
    "check:release-manual-blockers": "node scripts/check-release-manual-blockers.mjs",
    "check:release-artifact-manifest": "node scripts/release-artifact-manifest.mjs --check",
    "check:manual-qa-packet": "pnpm --filter @starlit-apprentice/product-core build && node scripts/manual-qa-packet.mjs --check",
    "check:release-packages": "pnpm build:android:qa-apk && pnpm check:android:qa-apk && pnpm build:android:aab && pnpm build:ios:release && pnpm check:play:local-artifact && pnpm check:app-store:local-artifact",
    "check:release:automated": "node scripts/check-release.mjs --allow-manual-blockers",
    "check:release": "node scripts/check-release.mjs",
    "test:e2e": "playwright test",
    "qa": "pnpm test && pnpm check:architecture && pnpm check:content && pnpm check:assets && pnpm check:android:icons && pnpm check:native-splash && pnpm check:store-config && pnpm check:versioning && pnpm check:webview-security && pnpm check:privacy && pnpm check:analytics-contract && pnpm check:third-party-notices && pnpm check:release-packages && pnpm build:apps-in-toss:candidate && pnpm check:apps-in-toss && pnpm release:artifact-manifest && pnpm check:release-artifact-manifest && pnpm check:release-verification-commands && pnpm check:release-manual-blockers && pnpm release:manual-qa-packet && pnpm check:manual-qa-packet && pnpm check:manual-qa && pnpm release:console-packet && pnpm check:release-console-packet && pnpm check:release-console && pnpm release:rating-content-inventory && pnpm check:rating-content-inventory && pnpm release:public-pages && pnpm check:public-pages && pnpm release:store-submission-packet && pnpm check:store-submission-packet && pnpm release:gate-dashboard && pnpm check:release-gate-dashboard && pnpm release:approval-packet && pnpm check:release-approval-packet && pnpm check:release-approval && pnpm check:save-contract && pnpm check:target-guidance && pnpm build && pnpm cap:sync && pnpm check:native-bundle-sync && pnpm check:bundle-budget && pnpm check:balance && pnpm check:pacing && pnpm check:runtime && pnpm check:ui-accessibility && pnpm check:package && pnpm check:public-url-guard && pnpm test:e2e && pnpm check:release:automated",
    "cap:sync": "pnpm --filter @starlit-apprentice/app cap:sync"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
